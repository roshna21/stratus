# Copy this file to `.env` and fill it in. `.env` is git-ignored and must
# never be committed.

# --- Azure ---------------------------------------------------------------
# Which subscription Stratus works against.
# Not a secret in itself, but it identifies your account, so keep it local.
# Find it with:   az account list --output table
AZURE_SUBSCRIPTION_ID=

# --- Model provider ------------------------------------------------------
# Stratus needs one. Gemini is the default because its free tier needs no
# payment card. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-flash-latest, an alias that tracks whatever
# the current Flash model is. Pinning a dated version breaks when Google
# retires it for new accounts. Override only to compare models.
# GEMINI_MODEL=

# Optional, and paid. Kept available so the same request can be run through
# more than one model and the results compared.
# ANTHROPIC_API_KEY=

# Optional. Forces a provider instead of picking whichever key is present.
# One of: gemini, anthropic
# STRATUS_MODEL_PROVIDER=
