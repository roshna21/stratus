# Copy this file to `.env` and fill it in. `.env` is git-ignored and must
# never be committed.
#
# Find your subscription id with:   az account list --output table

# Which Azure subscription Stratus works against.
# Not a secret in itself, but it identifies your account, so keep it local.
AZURE_SUBSCRIPTION_ID=

# Added in Phase 2, when the agent starts reasoning about requests.
# ANTHROPIC_API_KEY=
