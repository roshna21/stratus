# ---- Secrets: never commit these ----
.env
.env.*
!.env.example
*.pem
*.key
azure-credentials.json

# ---- Terraform ----
# Provider plugins: hundreds of MB, re-downloadable
.terraform/
.terraform.lock.hcl

# State files: these describe your real infrastructure and can contain
# passwords in plain text. They belong in remote storage, never in git.
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.coverage
htmlcov/

# `build/` above is Python's packaging output, but the pattern has no leading
# slash, so it matches a directory of that name at *any* depth — including
# the front end's /build route, which is a page and not an artifact. Without
# this exception that route is silently never committed: it works on the
# machine that wrote it and 404s on a fresh clone.
!web/app/build/

# ---- Node / Next.js ----
node_modules/
.next/
out/
npm-debug.log*

# ---- Editors / OS ----
.DS_Store
.vscode/
.idea/
*.swp

# Belt and braces: a stray history directory written by a bad path should
# never be committable again.
MagicMock/
